#cloud-boothook
#!/bin/sh
# CAPTF bootstrap fetch (gcp-machine). cloud-init runs boothooks on every
# boot, in its init stage, before it reads its configuration for the module
# stages. Once per instance this one reads the bootstrap payload from Secret
# Manager with the instance's service account token from the metadata server
# and installs it as system configuration in /etc/cloud/cloud.cfg.d, which
# cloud-init re-reads after the boothooks and before its init, config and
# final modules run (DESIGN.md decision 4). A gzip payload is decompressed
# first. Needs curl, sed, tr, base64, od and gzip; no gcloud.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
export PATH
# --- CAPTF staging stub: canonical head (CONVENTIONS.md section 13) ---
umask 077
config=/etc/cloud/cloud.cfg.d/99-captf-bootstrap.cfg
[ -s "$config" ] && exit 0
mkdir -p /etc/cloud/cloud.cfg.d
# Temporary names without .cfg: cloud-init reads only *.cfg there.
fetched=$(mktemp /etc/cloud/cloud.cfg.d/.captf-fetched.XXXXXX)
decoded=$(mktemp /etc/cloud/cloud.cfg.d/.captf-decoded.XXXXXX)
trap 'rm -f "$fetched" "$decoded"' EXIT
token_url=http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token
attempt=1
# Retries cover the access binding's IAM propagation after creation. The
# JSON response goes to "$decoded", which the tail overwrites; the payload
# itself, {"payload": {"data": "<base64>"}}, is decoded into "$fetched".
while :; do
  token=$(curl -fsS -H 'Metadata-Flavor: Google' "$token_url" | sed -n 's/.*"access_token" *: *"\([^"]*\)".*/\1/p') || token=
  if [ -n "$token" ] && curl -fsS -H "Authorization: Bearer $token" -o "$decoded" 'https://secretmanager.googleapis.com/v1/${secret_version}:access'; then
    break
  fi
  if [ "$attempt" -ge 60 ]; then
    echo "captf: giving up on the bootstrap secret after $attempt attempts" >&2
    exit 1
  fi
  attempt=$((attempt + 1))
  sleep 5
done
tr -d '\n' <"$decoded" | sed -n 's/.*"data" *: *"\([^"]*\)".*/\1/p' | base64 -d >"$fetched"
# --- CAPTF staging stub: canonical tail (CONVENTIONS.md section 13) ---
# Decompress a gzip payload, accept only cloud-config (a "#cloud-config"
# document, or a "## template: jinja" one, as CABPK writes, that renders
# to cloud-config), and install it 0600 through a temporary file in the
# same directory. A shell script or MIME payload is refused, not installed.
if [ "$(od -An -tx1 -N2 "$fetched" | tr -d ' \n')" = 1f8b ]; then
  gzip -dc "$fetched" >"$decoded"
else
  cat "$fetched" >"$decoded"
fi
captf_first=$(sed -n '1p' "$decoded" | tr -d '\r')
captf_second=$(sed -n '2p' "$decoded" | tr -d '\r')
case $captf_first in
  '#cloud-config'*) ;;
  '## template: jinja'*)
    case $captf_second in
      '#cloud-config'*) ;;
      *)
        echo "captf: the bootstrap payload is a Jinja template but not cloud-config; refusing it" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "captf: the bootstrap payload is not cloud-config; refusing it" >&2
    exit 1
    ;;
esac
chmod 0600 "$decoded"
mv "$decoded" "$config"
